config.local.js
node_modules/
*.log
.wrangler/

# --- Native (Capacitor) ---
# www/ is generated by scripts/build-web.sh from the real source files —
# never hand-edited, never committed. ios/ and android/ themselves ARE
# committed (they hold real hand-edits: Info.plist, generated icons,
# AndroidManifest merges) — only their own build output is ignored below.
www/
plugins/calm-nav-background/dist/
plugins/calm-nav-background/node_modules/

# iOS build output
ios/App/build/
ios/App/DerivedData/
ios/App/Pods/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
*.xcuserstate

# Android build output
android/.gradle/
android/app/build/
android/build/
android/capacitor-cordova-android-plugins/build/
android/local.properties
android/.idea/
*.iml

# Real GraphHopper key lives here for local `wrangler pages dev` runs — never
# commit it. Copy .dev.vars.example to .dev.vars and fill in your own key.
# In production the key is a Cloudflare Pages secret, not a file at all.
.dev.vars
